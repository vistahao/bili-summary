{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "audit_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "字幕错误仅限会改变知识或逻辑含义的高置信识别错误；其余项归为知识或逻辑风险。",
            "enum": ["疑似字幕错误", "疑似知识或逻辑错误"]
          },
          "timestamp": {"type": "string", "pattern": "^\\[\\d{2}:\\d{2}:\\d{2}\\]$"},
          "quote": {"type": "string", "minLength": 1},
          "concern": {
            "type": "string",
            "minLength": 1,
            "description": "说明具体知识结论、逻辑关系或关键含义受到什么影响；不评价口语和文风。"
          }
        },
        "required": ["category", "timestamp", "quote", "concern"],
        "additionalProperties": false
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["audit_items", "warnings"],
  "additionalProperties": false
}
